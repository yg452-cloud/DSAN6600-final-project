# =========================
# OS / Editor
# =========================
.DS_Store
Thumbs.db
.idea/
.vscode/

# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
.venv-segformer/

# =========================
# Build / Packaging
# =========================
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# =========================
# Logs / Temp
# =========================
*.log
logs/
tmp/
temp/
*.tmp

# =========================
# Large data files
# Keep dataset description files only
# =========================
data/*
!data/README.md
!data/splits/
!data/splits/*.txt
!data/subsets/
!data/subsets/*.txt

# Compressed data and model binaries
*.zip
*.7z
*.tar
*.tar.gz
*.gz
*.bz2
*.xz
*.pt
*.pth
*.ckpt
*.onnx
*.h5

# Large generated prediction dumps
outputs/*/test_predictions_full/
outputs/tables/


# Keep rendered report artifacts out of git by default
report/.quarto/
report/_site/
